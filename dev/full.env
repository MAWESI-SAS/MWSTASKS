# Entorno LOCAL completo para pruebas en navegador (no producción).
APP_RELEASE=v1.4.2
APP_DOMAIN=localhost:8088
WEB_URL=http://localhost:8088
CORS_ALLOWED_ORIGINS=http://localhost:8088
LISTEN_HTTP_PORT=8088
LISTEN_HTTPS_PORT=8443
SITE_ADDRESS=:80
SECRET_KEY=dev-only-secret-key-not-for-production-0123456789
LIVE_SERVER_SECRET_KEY=dev-only-live-secret
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_EMAIL=
CERT_ACME_DNS=
# La migración desde ClickUp hace miles de pedidos: en local subimos el límite por token (Plane trae 60/minute).
API_KEY_RATE_LIMIT=1200/minute
